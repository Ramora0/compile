# Copy to .env (or export in your shell) to override defaults.

# Port the HTTP/Socket.IO server binds to.
PORT=3000

# CORS origin allowed by the Socket.IO handshake.
# In production, set to the exact client URL (e.g. https://compile.example.com).
CORS_ORIGIN=*

# Milliseconds a disconnected player's seat is held before the match releases it.
# Lower while testing reconnect/grace behavior.
DISCONNECT_GRACE_MS=120000
